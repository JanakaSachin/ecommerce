generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ParcelSize {
  SMALL
  MEDIUM
  LARGE
}

/// Same values as SwiftDrop's ParcelStatus. Never add ASSIGNED.
enum DeliveryStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  PAUSED     // seller put the delivery on hold before pickup; can be released
  CANCELLED  // seller cancelled before pickup (final)
}

/// Same values as SwiftDrop's FailureReason.
enum FailureReason {
  RECIPIENT_UNAVAILABLE
  ADDRESS_NOT_FOUND
  REFUSED
  DAMAGED
  OTHER
}

/// The store's view of a shipment.
enum ShipmentState {
  PENDING_BOOKING
  BOOKED
  NEEDS_ATTENTION
  DELIVERED
  FAILED
  CANCELLED
}

enum EventSource {
  BOOKING
  WEBHOOK
  POLL
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(CUSTOMER)
  orders       Order[]
  carts        Cart[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?
  basePrice   Int              // in whole LKR
  imageUrl    String?
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String      // e.g. "Size 42 - Black"
  sku        String      @unique
  price      Int         // whole LKR
  stock      Int         @default(0)
  cartItems  CartItem[]
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
}

model Order {
  id           String      @id @default(cuid())
  orderNumber  Int         @unique @default(autoincrement())
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])

  // customer + address snapshot (personal data: never log it)
  email        String
  customerName String
  phone        String      // always +94XXXXXXXXX
  line1        String
  line2        String?
  city         String
  district     String
  postalCode   String?
  notes        String?

  subtotal     Int         // whole LKR
  deliveryFee  Int         // what the CUSTOMER pays us (whole LKR)
  total        Int

  items        OrderItem[]
  shipments    Shipment[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([email])
}

model OrderItem {
  id         String         @id @default(cuid())
  orderId    String
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  quantity   Int
  unitPrice  Int            // whole LKR
  lineTotal  Int            // whole LKR
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model Shipment {
  id                String          @id @default(cuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attempt           Int             @default(1)
  merchantRef       String          @unique   // "SLK-10045", "SLK-10045-2" … never changes
  state             ShipmentState   @default(PENDING_BOOKING)

  // what we send to SwiftDrop (snapshot taken at checkout)
  dropoffZoneId     String
  parcelSize        ParcelSize
  weightGrams       Int
  description       String

  // what SwiftDrop told us
  parcelId          String?         @unique
  trackingNumber    String?         @unique
  deliveryStatus    DeliveryStatus?
  lastSequence      Int             @default(0)   // highest SwiftDrop event sequence applied
  failureReason     FailureReason?
  courierFee        Decimal?        @db.Decimal(12, 2)  // SwiftDrop's fee = our cost
  bookedAt          DateTime?

  // booking retries
  bookingAttempts   Int             @default(0)
  nextBookingAt     DateTime?       @default(now())
  bookingLeaseUntil DateTime?
  lastBookingError  String?

  lastPolledAt      DateTime?
  events            DeliveryEvent[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([orderId, attempt])
  @@index([state, nextBookingAt])
  @@index([state, lastPolledAt])
}

/// One row per status per shipment: the timeline the customer sees.
model DeliveryEvent {
  id            String         @id @default(cuid())
  shipmentId    String
  shipment      Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status        DeliveryStatus
  failureReason FailureReason?
  sequence      Int            // SwiftDrop's per-parcel sequence (CREATED = 1)
  eventId       String?        // from webhooks only
  source        EventSource
  occurredAt    DateTime
  createdAt     DateTime       @default(now())

  @@unique([shipmentId, sequence])
}

/// Copy of SwiftDrop zones. id = SwiftDrop's zone UUID.
model DeliveryZone {
  id        String         @id
  code      String         @unique
  name      String
  active    Boolean        @default(true)
  syncedAt  DateTime       @default(now())
  districts DistrictZone[]
  rates     DeliveryRate[]
}

/// Which SwiftDrop zone serves each Sri Lankan district.
model DistrictZone {
  district String       @id   // e.g. "Kandy"
  zoneId   String
  zone     DeliveryZone @relation(fields: [zoneId], references: [id])
}

/// What the store charges the customer for delivery (admin-editable).
model DeliveryRate {
  id     String       @id @default(cuid())
  zoneId String
  zone   DeliveryZone @relation(fields: [zoneId], references: [id])
  size   ParcelSize
  fee    Int          // whole LKR

  @@unique([zoneId, size])
}

/// Every webhook we received. eventId is set ONLY for PROCESSED rows (it's the dedupe key).
model WebhookLog {
  id             String   @id @default(cuid())
  eventId        String?  @unique
  rawEventId     String?
  eventType      String?
  signatureValid Boolean
  result         String   // PROCESSED | REJECTED | IGNORED | ERROR
  error          String?
  payload        Json?    // SwiftDrop payloads contain no personal data
  receivedAt     DateTime @default(now())

  @@index([receivedAt])
}
